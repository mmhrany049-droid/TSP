# نمونهٔ متغیرهای محیطی — این فایل را به .env کپی کنید.
# SQLite (پیش‌فرض نسخهٔ ۰.۲): فایل پایگاه داده در پوشهٔ prisma/ ساخته می‌شود.
DATABASE_URL="file:./prisma/dev.db"

# برای PostgreSQL در نسخه‌های بعدی (به همراه تغییر provider در prisma/schema.prisma
# و استفاده از @prisma/adapter-pg در prisma.config.ts):
