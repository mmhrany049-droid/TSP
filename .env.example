# نمونهٔ متغیرهای محیطی — این فایل را به .env کپی کنید.
# SQLite (پیش‌فرض نسخهٔ ۰.۲): فایل پایگاه داده در پوشهٔ prisma/ ساخته می‌شود.
DATABASE_URL="file:./prisma/dev.db"

# برای PostgreSQL در نسخه‌های بعدی (به همراه تغییر provider در prisma/schema.prisma
# و استفاده از @prisma/adapter-pg در prisma.config.ts):
# DATABASE_URL="postgresql://user:password@localhost:5432/tsp?schema=public"

# کلید امضای نشست NextAuth (الزامی).
# مقدار تازه بسازید و در فایل .env بگذارید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"

# در محیط پروکسی/پیش‌نمایش، NextAuth خودِ میزبان را باور می‌کند (trustHost در lib/auth.config.ts).
