# ---------------------------------------------------------------------------
# نمونهٔ متغیرهای محیطی TSP (نسخهٔ ۰.۲)
#
# این فایل را به .env کپی کنید و مقادیر را پر کنید.  یا ساده‌تر:
#   npm run init:env          ← ساخت خودکار .env با کلید تصادفی
#
# قالب هر خط باید دقیقاً «KEY=VALUE» باشد:
#   • دور علامت = فاصله نگذارید (پرامپت ویندوز آن را بخشی از نام می‌گیرد).
#   • مقادیر را می‌توانید داخل نقل‌قول بگذارید.
#   • کاراکتر # در ابتدای خط، آن خط را توضیح می‌کند.
# ---------------------------------------------------------------------------

# آدرس پایگاه داده (SQLite محلی). فایل در پوشهٔ prisma ساخته می‌شود.
# اگر این خط نباشد، همین مقدار به‌صورت پیش‌فرض استفاده می‌شود.
DATABASE_URL="file:./prisma/dev.db"

# کلید امضای کوکی نشست (NextAuth).
#   • در حالت توسعه (npm run dev): اگر نباشد، برنامه با یک کلید موقت بالا می‌آید و
#     در صفحهٔ ورود راهنمای ساخت آن را نشان می‌دهد.
#   • در حالت تولید (npm run build + npm start): بدون این کلید، ورود کار نمی‌کند و
#     برنامه پیام فارسی «کلید امنیتی نشست تنظیم نشده است» را نشان می‌دهد.
#
# ساخت مقدار تصادفی (یکی از دو روش):
#   npm run init:env -- --force
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------------------
# گزینه‌های نسخه‌های بعدی
# ---------------------------------------------------------------------------

# PostgreSQL (نسخهٔ ۰.۳ به بعد): علاوه بر این خط، باید provider در
# prisma/schema.prisma و آداپتور در prisma.config.ts هم تغییر کند.
# DATABASE_URL="postgresql://user:password@localhost:5432/tsp?schema=public"

# آدرس عمومی برنامه در محیط واقعی (روی میزبان ابری خودش تنظیم می‌شود).
# AUTH_URL="https://example.com"
